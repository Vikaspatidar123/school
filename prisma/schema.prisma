generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ==================== RBAC SYSTEM ====================

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("student")
  avatar    String?
  status    String   @default("active") // active, inactive, suspended
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student       Student?
  teacher       Teacher?
  parent        Parent?
  notifications    Notification[]
  sentMessages     Message[]      @relation("sender")
  receivedMessages Message[]      @relation("receiver")
}

model Permission {
  id       String @id @default(cuid())
  module   String
  action   String
  role     String

  @@unique([module, action, role])
}

// ==================== ACADEMICS ====================

model Student {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId        String?
  class          Class?   @relation(fields: [classId], references: [id])
  parentId       String?
  parent         Parent?  @relation(fields: [parentId], references: [id])
  rollNo         String?
  admissionNo    String?  @unique
  admissionDate  DateTime?
  dob            DateTime?
  gender         String?
  bloodGroup     String?
  address        String?
  phone          String?
  emergencyPhone String?
  medicalNotes   String?
  status         String   @default("active") // active, graduated, transferred
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  attendance          Attendance[]
  fees                Fee[]
  results             Result[]
  bookIssues          BookIssue[]
  submissions         Submission[]
  transportAlloc      TransportAllocation[]
  practiceTestAttempts PracticeTestAttempt[]
}

model Teacher {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId    String?  @unique
  subject       String?
  qualification String?
  experience    String?
  phone         String?
  salary        Float?
  joinDate      DateTime?
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  classes     Class[]
  timetables  Timetable[]
  leaves      Leave[]
  assignments Assignment[]
}

model Parent {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone      String?
  occupation String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  students Student[]
}

model Class {
  id        String   @id @default(cuid())
  name      String
  section   String
  capacity  Int      @default(40)
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students    Student[]
  timetables  Timetable[]
  assignments Assignment[]
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  timetables Timetable[]
}

// ==================== ATTENDANCE ====================

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime
  status    String   // present, absent, late, half_day
  markedBy  String?
  remarks   String?
  createdAt DateTime @default(now())

  @@unique([studentId, date])
}

// ==================== FINANCE ====================

model Fee {
  id          String    @id @default(cuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount      Float
  type        String    // tuition, transport, library, exam, admission, sports
  status      String    @default("pending") // pending, paid, overdue, partial
  dueDate     DateTime
  paidDate    DateTime?
  paidAmount  Float?
  fine        Float     @default(0)
  receiptNo   String?
  paymentMode String?   // cash, online, cheque
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ==================== EXAMINATION ====================

model Exam {
  id         String   @id @default(cuid())
  name       String
  classId    String
  subject    String
  date       DateTime
  totalMarks Float
  passingMarks Float  @default(33)
  examType   String   @default("unit") // unit, midterm, final, practice
  createdAt  DateTime @default(now())

  results Result[]
}

model Result {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  marks     Float
  grade     String?
  rank      Int?
  remarks   String?
  createdAt DateTime @default(now())

  @@unique([studentId, examId])
}

// ==================== TIMETABLE ====================

model Timetable {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  day       String   // monday, tuesday, ...
  startTime String   // "09:00"
  endTime   String   // "09:45"
  room      String?
  createdAt DateTime @default(now())

  @@unique([classId, day, startTime])
}

// ==================== ASSIGNMENTS ====================

model Assignment {
  id          String   @id @default(cuid())
  title       String
  description String?
  classId     String
  class       Class    @relation(fields: [classId], references: [id])
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id])
  subject     String
  dueDate     DateTime
  totalMarks  Float?
  createdAt   DateTime @default(now())

  submissions Submission[]
}

model Submission {
  id           String   @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id])
  content      String?
  marks        Float?
  status       String   @default("pending") // pending, submitted, graded
  submittedAt  DateTime?
  createdAt    DateTime @default(now())

  @@unique([assignmentId, studentId])
}

// ==================== LIBRARY ====================

model Book {
  id        String   @id @default(cuid())
  title     String
  author    String
  isbn      String?  @unique
  category  String
  quantity  Int      @default(1)
  available Int      @default(1)
  shelf     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issues BookIssue[]
}

model BookIssue {
  id         String    @id @default(cuid())
  bookId     String
  book       Book      @relation(fields: [bookId], references: [id])
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id])
  issueDate  DateTime  @default(now())
  dueDate    DateTime
  returnDate DateTime?
  fine       Float     @default(0)
  status     String    @default("issued") // issued, returned, overdue

  createdAt DateTime @default(now())
}

// ==================== TRANSPORT ====================

model Route {
  id        String   @id @default(cuid())
  name      String
  stops     String   // JSON string of stops
  driver    String?
  busNo     String?
  capacity  Int      @default(40)
  createdAt DateTime @default(now())

  allocations TransportAllocation[]
}

model TransportAllocation {
  id        String   @id @default(cuid())
  routeId   String
  route     Route    @relation(fields: [routeId], references: [id])
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  stopName  String?
  createdAt DateTime @default(now())

  @@unique([routeId, studentId])
}

// ==================== LEAVE MANAGEMENT ====================

model Leave {
  id        String   @id @default(cuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  startDate DateTime
  endDate   DateTime
  reason    String
  type      String   // sick, casual, earned
  status    String   @default("pending") // pending, approved, rejected
  createdAt DateTime @default(now())
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("info") // info, warning, success, urgent
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  targetRole String  @default("all") // all, student, teacher, parent
  priority  String   @default("normal") // low, normal, high, urgent
  authorId  String
  expiresAt DateTime?
  createdAt DateTime @default(now())
}

// ==================== MESSAGING ====================

model Message {
  id           String   @id @default(cuid())
  senderId     String
  sender       User     @relation("sender", fields: [senderId], references: [id])
  receiverId   String?
  receiver     User?    @relation("receiver", fields: [receiverId], references: [id])
  receiverRole String   @default("") // role-based broadcast
  subject      String
  content      String
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())
}

// ==================== PRACTICE TESTS ====================

model PracticeTest {
  id          String   @id @default(cuid())
  title       String
  subject     String
  totalMarks  Int
  duration    Int      @default(30) // minutes
  questions   String   // JSON string of questions
  createdAt   DateTime @default(now())

  attempts PracticeTestAttempt[]
}

model PracticeTestAttempt {
  id             String   @id @default(cuid())
  testId         String
  test           PracticeTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers        String   // JSON string of answers
  score          Int
  totalQuestions Int
  timeTaken      Int?     // seconds
  completedAt    DateTime @default(now())

  @@unique([testId, studentId])
}

// ==================== EVENTS ====================

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  endDate     DateTime?
  type        String   @default("event") // event, holiday, exam, meeting
  createdAt   DateTime @default(now())
}
